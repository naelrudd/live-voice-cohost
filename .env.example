# ---- LLM (OpenAI-compatible) --------------------------------------------
# Default = OpenRouter FREE tier (no credit card). Any one API key swaps the
# whole brain; bring your own base URL + key + model from any provider below.
#   OpenRouter (free, 20+ models): base https://openrouter.ai/api/v1
#     key = OPENROUTER_API_KEY, model = meta-llama/llama-3.3-70b-instruct:free
#   Groq (fast LPU):     base https://api.groq.com/openai/v1, key = GROQ_API_KEY
#   GitHub Models:       base https://models.inference.ai.azure.com, key = GH token
#   Google Gemini:       base https://generativelanguage.googleapis.com/v1beta/openai/
#   Together / NVIDIA NIM / vLLM / any /v1/chat/completions endpoint works too.
JARVIS_LLM_BASE_URL=https://openrouter.ai/api/v1
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# "none" disables reasoning tokens (big TTFT win for voice). Empty = provider default.
JARVIS_LLM_REASONING_EFFORT=none
JARVIS_LLM_TEMPERATURE=0.8
JARVIS_LLM_MAX_TOKENS=220

# ---- STT -----------------------------------------------------------------
# groq | local | none
# groq is the fast path (~0.3-0.5 s) and needs JARVIS_GROQ_API_KEY (free tier).
# Without a key it silently falls back to local faster-whisper.
JARVIS_STT_BACKEND=groq
JARVIS_GROQ_API_KEY=
JARVIS_GROQ_STT_MODEL=whisper-large-v3-turbo
# Local fallback speed/accuracy tradeoff, measured on a 12-core CPU (id, 2.9 s clip):
#   tiny  ~0.48 s warm, unusable ("XAUUSD timeframe" -> "charge saus dimetramah")
#   base  ~0.78 s warm @4thr, tickers garbled ("XAUUSD" -> "Bukacart sawus")
#   small ~3.57 s warm, correct on XAUUSD/IHSG/kurs
# Use base/tiny for snappy demos, small when accuracy beats latency (no GPU/Groq key).
JARVIS_LOCAL_WHISPER_MODEL=small
JARVIS_LOCAL_WHISPER_DEVICE=cpu
JARVIS_LOCAL_WHISPER_COMPUTE=int8
# 4 beats 12 here: OBS + browser already saturate the cores.
JARVIS_LOCAL_WHISPER_THREADS=4
# ISO code hint for Groq/local whisper ("id" = Indonesian, "" = autodetect)
JARVIS_STT_LANGUAGE=id

# ---- TTS -----------------------------------------------------------------
# edge | cartesia | sapi
JARVIS_TTS_BACKEND=edge
JARVIS_TTS_VOICE=id-ID-ArdiNeural
JARVIS_TTS_RATE=+8%     # edge-tts speaking rate, e.g. +10%
JARVIS_CARTESIA_API_KEY=
JARVIS_CARTESIA_VOICE_ID=
JARVIS_CARTESIA_MODEL=sonic-2

# ---- Audio devices (substring match, first hit wins) ---------------------
# Route audio into OBS with a virtual cable: set JARVIS_OUTPUT_DEVICE=CABLE Input
JARVIS_OUTPUT_DEVICE=
JARVIS_INPUT_DEVICE=
JARVIS_SAMPLE_RATE=24000

# ---- Hotkeys -------------------------------------------------------------
# Stream Deck button → F13. Kill switch stops TTS + cancels running tools.
JARVIS_PTT_KEY=f13
JARVIS_PTT_FALLBACK_KEY=ctrl+alt+j
JARVIS_KILL_KEY=ctrl+alt+q

# ---- Tools ---------------------------------------------------------------
JARVIS_TOOLS_ENABLED=true
JARVIS_TAVILY_API_KEY=

# ---- Server / overlay ----------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8848

# ---- Persona -------------------------------------------------------------
# Name Jarvis addresses on air. Override per streamer, no code changes.
JARVIS_STREAMER_NAME=Pak Febri

# ---- Guardrails ----------------------------------------------------------
# Comma separated substrings of actions the browser/OS agent may never click.
JARVIS_DENY_ACTIONS=buy,sell,order,withdraw,transfer,confirm payment,place order
