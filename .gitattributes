# Normalize line endings across platforms
* text=auto

# Windows scripts must keep CRLF so cmd.exe runs them correctly
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source and configs are LF
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.html text eol=lf
*.json text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf